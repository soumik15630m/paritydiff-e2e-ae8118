{
  "openapi": "3.0.3",
  "info": {
    "title": "ParityDiff synthetic monitoring API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://monitoring-fixture.invalid"
    }
  ],
  "paths": {
    "/v1/chat": {
      "post": {
        "operationId": "chat",
        "summary": "Send a synthetic message",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "message"
                ],
                "properties": {
                  "message": {
                    "type": "string"
                  },
                  "model": {
                    "type": "string"
                  },
                  "temperature": {
                    "type": "number"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Synthetic response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "reply"
                  ],
                  "properties": {
                    "reply": {
                      "type": "string"
                    },
                    "request_id": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Healthy"
          }
        }
      }
    }
  }
}
